# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-32-plus-character-secret

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:80

# --- MongoDB Atlas ---
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=disaster_relief_platform

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/data/uploads
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- AI / ML ---
GEMINI_API_KEY=your-gemini-api-key
YOLO_WEIGHTS_PATH=app/ml/weights/severity_yolov8.pt
ML_INFERENCE_DEVICE=cpu

# --- Notifications ---
SMS_PROVIDER_SID=
SMS_PROVIDER_TOKEN=
PUSH_NOTIFICATION_KEY=

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# --- Seed admin (used by migrations/002_seed_admin.py) ---
SEED_ADMIN_EMAIL=admin@disaster-relief.platform
SEED_ADMIN_PASSWORD=change-me-strong-password

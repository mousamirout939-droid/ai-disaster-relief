{
  "title": "Disaster Relief Platform - Operations Overview",
  "panels": [
    { "title": "Request Rate", "type": "graph", "targets": [{ "expr": "rate(http_requests_total[5m])" }] },
    { "title": "P95 Latency", "type": "graph", "targets": [{ "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))" }] },
    { "title": "Error Rate (5xx)", "type": "graph", "targets": [{ "expr": "rate(http_requests_total{status=~\"5..\"}[5m])" }] },
    { "title": "Active Incidents (Critical/High)", "type": "stat", "targets": [{ "expr": "incident_severity_count{severity=~\"critical|high\"}" }] }
  ],
  "schemaVersion": 39,
  "version": 1
}

# Rename to secrets.yaml, base64-encode real values, and NEVER commit the
# populated version. Prefer sealed-secrets / external-secrets-operator /
# a cloud KMS-backed secret manager in real production clusters.
apiVersion: v1
kind: Secret
metadata:
  name: relief-secrets
  namespace: disaster-relief
type: Opaque
data:
  SECRET_KEY: <base64-encoded-jwt-secret>
  MONGODB_URI: <base64-encoded-mongodb-atlas-uri>
  GEMINI_API_KEY: <base64-encoded-gemini-key>
  S3_ACCESS_KEY: <base64-encoded-s3-access-key>
  S3_SECRET_KEY: <base64-encoded-s3-secret-key>
